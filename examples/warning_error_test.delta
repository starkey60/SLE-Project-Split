    sort "Income" (bool) descending
}

Filter employee_dat {
    "Income" (float) >= "20000"
    "Age" (int) <= 40.555
    "Pets" (bool) == false
    "Employment status" (string) >= "employee"
    "Region" (string) in [20, "200"]
    "Region" (string) in [20, 200]
}

